// Example Nox file
struct Point
    x: int,
    y: int
end

func distance(p1: ref Point, p2: ref Point) -> float
    let dx: int = p2.x - p1.x
    let dy: int = p2.y - p2.y
    return sqrt(dx * dx + dy * dy)
end

let origin: Point = {x: 0, y: 0}
let point: Point = {x: 3, y: 4}

print("Distance: " + to_str(distance(origin, point)))
